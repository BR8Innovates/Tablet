            "value": "{{tenant}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"DataTableName\": \"Relationship\",\n    //\"Id\": \"2\",\n    \"ChannelCode\": \"{{channelCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/list-master-table"
        }
      },
      "response": []
    },
