{
  "info": {
    "name": "UPONLY TL001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Term Life (TL001). Select the MC or UAT environment, fill username/password, run Token first. Secrets are not stored in this file."
  },
  "item": [
    {
      "name": "Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-mo-user-source-id",
            "value": "platform"
          },
          {
            "key": "x-mo-tenant-id",
            "value": "{{tenant}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{casUrl}}/cas/ebao/v2/json/tickets"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Data Table API",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
