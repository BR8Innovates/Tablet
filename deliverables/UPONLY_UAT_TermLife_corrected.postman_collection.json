  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function pad(n){return (n<10?'0':'')+n;}",
          "function ymd(d){return d.getUTCFullYear()+'-'+pad(d.getUTCMonth()+1)+'-'+pad(d.getUTCDate());}",
          "var now=new Date(), eff=new Date(now.getTime()+86400000), exp=new Date(eff.getTime()); exp.setUTCFullYear(exp.getUTCFullYear()+1); exp.setUTCDate(exp.getUTCDate()-1);",
          "var cv=pm.collectionVariables;",
          "cv.set('applyDate',ymd(now)); cv.set('effectiveDate',ymd(eff)); cv.set('expiry1y',ymd(exp)+'T23:59:59'); cv.set('cancelDate',ymd(new Date(eff.getTime()+30*86400000)));",
          "cv.set('monthStart',now.getUTCFullYear()+'-'+pad(now.getUTCMonth()+1)+'-01'); cv.set('monthEnd',ymd(new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth()+1,0))));",
          "var ts=parseInt(cv.get('appNoTs')||'0',10); if(!cv.get('applicationNo')||now.getTime()-ts>30*60*1000){cv.set('applicationNo','TL'+now.getTime());cv.set('appNoTs',String(now.getTime()));}",
          "// the access token lasts about 2 hours: fetch a new one when it is missing or older than 100 minutes",
          "var tokAt=parseInt(cv.get('tokenAt')||'0',10);",
          "if(pm.info.requestName.indexOf('Get Token')<0 && pm.variables.get('username') && (!cv.get('token') || now.getTime()-tokAt>100*60*1000)){",
          "  pm.sendRequest({url: pm.variables.get('casUrl')+'/cas/ebao/v2/json/tickets', method:'POST', header:{'Content-Type':'application/json','x-mo-user-source-id':'platform','x-mo-tenant-id':'uponlyuat'}, body:{mode:'raw', raw: JSON.stringify({username: pm.variables.get('username'), password: pm.variables.get('password')})}}, function(err,res){",
          "    if(err){console.warn('token fetch failed: '+err);return;} cv.set('token', res.json().access_token); cv.set('tokenAt', String(Date.now()));});",
          "}"
        ]
      }
    }
  ],
