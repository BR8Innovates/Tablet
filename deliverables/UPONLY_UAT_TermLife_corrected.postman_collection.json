{
  "info": {
    "name": "UPONLY UAT - Term Life (corrected)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Term Life (TL001, variant 1, plan 1) on the UAT tenant. Set username and password in the collection variables, run '0. Get Token' (or just run a request: the token is refreshed automatically), then run the folder in order. ProposalNo, PolicyNo and RequestNo are saved by the tests of the previous requests; dates and ApplicationNo are generated. Differences from the earlier collection: no stored bearer tokens, no fixed proposal / policy / request numbers, current dates, one variant (1) in every request, no premium sent (the platform rates the plan), no // comments inside bodies."
  },
  "item": [
    {
      "name": "UAT - Term Life",
      "item": [
        {
          "name": "0. Get Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-mo-user-source-id",
                "value": "platform"
              },
              {
                "key": "x-mo-tenant-id",
                "value": "uponlyuat"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{casUrl}}/cas/ebao/v2/json/tickets",
              "host": [
                "{{casUrl}}"
              ],
              "path": [
                "cas",
                "ebao",
                "v2",
                "json",
                "tickets"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);",
                  "pm.collectionVariables.set('tokenAt', String(Date.now()));"
                ]
              }
            }
          ]
        },
