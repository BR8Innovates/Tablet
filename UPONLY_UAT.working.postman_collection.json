  "item": [
    {
      "name": "0. Get Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200/201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "var t = pm.response.text(); var tok = null;",
              "try { var j = JSON.parse(t); tok = j.access_token || j.token || j.ticket || j.Token || (j.data && (j.data.access_token || j.data.token || j.data.ticket)); } catch(e) { tok = t.trim(); }",
              "pm.test('Token returned', function () { pm.expect(tok).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('token', tok);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-mo-user-source-id",
            "value": "platform"
          },
          {
            "key": "x-mo-tenant-id",
            "value": "{{tenant}}"
          }
        ],
        "url": {
          "raw": "{{casUrl}}/cas/ebao/v2/json/tickets",
          "host": [
            "{{casUrl}}"
          ],
          "path": [
            "cas",
            "ebao",
            "v2",
            "json",
            "tickets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Fetches a CAS ticket and stores it in `token`. Set `username` and `password` first (not stored in this collection). Re-run on 401.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
