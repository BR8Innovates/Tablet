    },
    {
      "key": "gatewayUrl",
      "value": "https://sandbox-in-gw.insuremo.com"
    },
    {
      "key": "tenant",
      "value": "uponlyuat"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
