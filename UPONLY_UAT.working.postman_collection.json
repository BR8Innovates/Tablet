{
  "info": {
    "name": "UPONLY - UAT (working)",
    "description": "Working UPONLY PA001 flow against the UAT sandbox.\n\nSetup: set `username` and `password`, run **0. Get Token**, then run requests 1-10 in order. Dates and ApplicationNo are generated per run; ProposalNo / PolicyNo / rejectProposalNo are filled by test scripts. Credentials are intentionally not stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function pad(n){return (n<10?'0':'')+n;}",
          "function ymd(d){return d.getUTCFullYear()+'-'+pad(d.getUTCMonth()+1)+'-'+pad(d.getUTCDate());}",
          "var now=new Date(), eff=new Date(now.getTime()+86400000);",
          "var exp=new Date(eff.getTime()); exp.setUTCFullYear(exp.getUTCFullYear()+1); exp.setUTCDate(exp.getUTCDate()-1);",
          "var cv=pm.collectionVariables;",
          "cv.set('applyDate',ymd(now)); cv.set('effectiveDate',ymd(eff)); cv.set('expiry1y',ymd(exp)+'T23:59:59');",
          "cv.set('monthStart',now.getUTCFullYear()+'-'+pad(now.getUTCMonth()+1)+'-01');",
          "cv.set('monthEnd',ymd(new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth()+1,0))));",
          "// Unique ApplicationNo, refreshed every 30 min so re-runs do not collide.",
          "var ts=parseInt(cv.get('appNoTs')||'0',10);",
          "if(!cv.get('applicationNo')||now.getTime()-ts>30*60*1000){cv.set('applicationNo',String(now.getTime()));cv.set('appNoTs',String(now.getTime()));}",
          "if(!cv.get('token')&&pm.info.requestName.indexOf('Get Token')<0){console.warn('token is empty - run \"0. Get Token\" or set the token variable.');}",
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://uponlyuat-sandbox-in.insuremo.com/api/uponlyuat/api-orchestration/v1/flow"
